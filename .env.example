# OpenDraw Bun – konfigurace serveru (jediný zdroj: apps/server/src/config.ts)
# Zkopíruj do .env a vyplň. Nikdy necommituj .env.
#
# Relativní cesty se resolvují vůči cwd, vedoucí ~ expanduje na homedir.
# Žádné absolutní cesty s konkrétním uživatelem do .env nepatří.

# --- DrawThings server ---
# Adresa HTTP API DrawThings (lokální server, default viz DrawThings app).
DT_HOST=127.0.0.1
DT_PORT=7859
# API klíč DrawThings (cloud modely). Prázdné = cloud nedostupný, lokální OK.
DT_API_KEY=

# --- Cesty k modelům a dokumentům DrawThings ---
# Prázdné = darwin default přes ~ expanzi (viz config.ts):
#   ~/Library/Containers/com.liuliu.draw-things/Data/Documents[/Models]
MODELS_DIR=
# Zpětná kompatibilita (staré proxy): když je MODELS_DIR prázdné, použije se
# OPEN_DRAW_MODELS_DIR. Nově nastavuj jen MODELS_DIR.
# OPEN_DRAW_MODELS_DIR=
DT_DOCS_DIR=

# --- TLS certifikát DrawThings (PEM) ---
# Příklad: SSL_CERT_PATH=~/ssl.cert
# Prázdné = /api/echo selže až při volání, server naběhne.
SSL_CERT_PATH=

# --- Lokální data serveru (galerie, canvas, cache) ---
DATA_DIR=./data

# --- HTTP server opendraw-bun ---
PORT=3001
HOST=localhost
# Veřejný režim (poslech na všech rozhraních): HOST=0.0.0.0
